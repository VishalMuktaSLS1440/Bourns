<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.sodales.bourns_24hr</groupId>
    <artifactId>Bourns_24Hr</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Bourns_24Hr</name>
    <!-- FIXME change it to the project's website -->
    <url>http://www.example.com</url>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.verbose>true</maven.compiler.verbose>
        <suiteXmlFile>${basedir}/src/test/resources/testSuites/testng.xml</suiteXmlFile>
    </properties>
    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.11</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <version>3.141.59</version>
            <artifactId>selenium-server</artifactId>
            <groupId>org.seleniumhq.selenium</groupId>
        </dependency>
        <dependency>
            <version>7.12.0</version>
            <artifactId>testng</artifactId>
            <groupId>org.testng</groupId>
        </dependency>
        <dependency>
            <version>2.35.2</version>
            <artifactId>allure-testng</artifactId>
            <groupId>io.qameta.allure</groupId>
        </dependency>
        <dependency>
            <systemPath>${project.basedir}/lib/automationframeworkexecution.jar</systemPath>
            <version>1.0</version>
            <scope>system</scope>
            <artifactId>Locators</artifactId>
            <groupId>com.sodales.webautomationexecution</groupId>
        </dependency>
        <dependency>
            <version>6.3.4</version>
            <artifactId>webdrivermanager</artifactId>
            <groupId>io.github.bonigarcia</groupId>
        </dependency>
        <dependency>
            <version>3.1.6</version>
            <artifactId>healenium-web</artifactId>
            <groupId>com.epam.healenium</groupId>
        </dependency>
        <dependency>
            <version>2.0.5</version>
            <artifactId>sikulixapi</artifactId>
            <groupId>com.sikulix</groupId>
        </dependency>
        <dependency>
            <version>1.9.9.1</version>
            <artifactId>aspectjweaver</artifactId>
            <groupId>org.aspectj</groupId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <version>20260522</version>
            <artifactId>json</artifactId>
            <groupId>org.json</groupId>
            <scope>test</scope>
        </dependency>
        
         <dependency>
            <version>5.6.8</version>
            <artifactId>agent-java-testng</artifactId>
            <groupId>com.epam.reportportal</groupId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okio</groupId>
            <artifactId>okio</artifactId>
            <version>3.6.0</version>
        </dependency>
        <dependency>
            <version>0.7.7.0</version>
            <artifactId>monte-screen-recorder</artifactId>
            <groupId>com.github.stephenc.monte</groupId>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
            <plugins>
                <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <!-- default lifecycle, jar packaging: see https://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_jar_packaging -->
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.0.2</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.8.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.1</version>
                    <configuration>
                        <suiteXmlFiles>
                            <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                        </suiteXmlFiles>
                        <argLine>-javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/1.9.9.1/aspectjweaver-1.9.9.1.jar"</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.0.2</version>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>2.5.2</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>2.8.2</version>
                </plugin>
                <!-- site lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#site_Lifecycle -->
                <plugin>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>3.0.0</version>
                </plugin>
                <plugin>
                    <version>2.10.0</version>
                    <artifactId>allure-maven</artifactId>
                    <groupId>io.qameta.allure</groupId>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
